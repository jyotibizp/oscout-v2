<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oscout.backend</string>
  <key>WorkingDirectory</key><string>__ROOT__/backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/backend/.venv/bin/uvicorn</string>
    <string>app.main:app</string>
    <string>--host</string><string>0.0.0.0</string>
    <string>--port</string><string>8000</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FRONTEND_URL</key><string>http://127.0.0.1:8000/</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__ROOT__/.run/service.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/.run/service.log</string>
</dict>
</plist>

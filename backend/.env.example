# Copy to backend/.env and adjust. Strategy parameters are NOT here — edit them in the app (ADX Configuration).
DATABASE_URL=sqlite:///./oscout_v2.db
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/oscout_v2
DATA_PROVIDER=mock            # mock | kite
KITE_API_KEY=
KITE_API_SECRET=
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
INITIAL_BACKFILL_DAYS=30
START_SCHEDULER=true
LOG_LEVEL=INFO
LOG_JSON=true
